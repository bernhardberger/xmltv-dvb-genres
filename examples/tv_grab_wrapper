#!/bin/sh
# Tvheadend grabber wrapper: runs tv_grab_zz_sdjson and adds DVB genres.
#
# Install it as /usr/local/bin/tv_grab_zz_sdjson_genres, or under any other
# tv_grab_* name on Tvheadend's PATH, and restart Tvheadend. It then appears as
# "XMLTV: Schedules Direct JSON API with DVB genres" next to the plain
# grabber. Give it the same Extra arguments as tv_grab_zz_sdjson, for example
#   --config-file /var/lib/tvheadend/.xmltv/tv_grab_zz_sdjson.conf --days 7
#
# For another grabber, change REAL and DESCRIPTION.
#
# FILTER_ARGS passes options to the filter, for example
# FILTER_ARGS="-format eit" on a Tvheadend build that handles the Category
# Code XPath safely (see docs/tvheadend.md).
#
# The guide is never lost: without xmltv-dvb-genres, or if it fails, the
# grabber output is passed through.

REAL=${REAL:-/usr/bin/tv_grab_zz_sdjson}
DESCRIPTION=${DESCRIPTION:-Schedules Direct JSON API with DVB genres}
FILTER=${FILTER:-xmltv-dvb-genres}
FILTER_ARGS=${FILTER_ARGS:-}

case "$1" in
--description)
	# Tvheadend names the module after this; keep it distinct from REAL's.
	echo "$DESCRIPTION"
	exit 0
	;;
--capabilities | --version | --configure)
	exec "$REAL" "$@"
	;;
esac

if ! command -v "$FILTER" >/dev/null 2>&1; then
	exec "$REAL" "$@"
fi

tmp=$(mktemp) || exec "$REAL" "$@"
trap 'rm -f "$tmp"' EXIT

# Keep the grabber's own exit status: a failed grab must stay failed.
"$REAL" "$@" >"$tmp" || exit $?

# xmltv-dvb-genres always writes the guide, even when it reports an error.
# FILTER_ARGS is split on spaces on purpose.
# shellcheck disable=SC2086
"$FILTER" $FILTER_ARGS "$tmp" || true
