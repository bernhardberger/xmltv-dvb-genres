{
  "name": "schedulesdirect-en",
  "description": "Schedules Direct (Gracenote) genres as written by XMLTV grabbers such as tv_grab_zz_sdjson and EpGo. Rules run top to bottom; the first match wins. Order: non-programmes, adult, sport, children, news, documentary, leisure, show formats, fiction, arts and music, factual topics, generic film/show fallbacks. Codes outside 0x10-0xAF are avoided because Tvheadend has no names for them.",
  "lang": "en",
  "rules": [
    {"code": "0xa6", "any": ["shopping", "paid programming", "auction", "collectibles"], "comment": "teleshopping and infomercials"},
    {"code": "0x18", "any": ["erotic", "adults only"]},

    {"code": "0x43", "any": ["soccer"], "comment": "SD 'football' is American football, see team sports"},
    {"code": "0x44", "any": ["tennis"]},
    {"code": "0x45", "any": ["football", "australian rules football", "rugby", "rugby union", "basketball", "baseball", "hockey", "field hockey", "volleyball", "handball", "cricket"]},
    {"code": "0x46", "any": ["running", "track/field", "triathlon", "gymnastics"]},
    {"code": "0x47", "any": ["motorsports", "auto racing", "motorcycle racing", "drag racing"]},
    {"code": "0x48", "any": ["watersports", "surfing", "sailing", "boat racing"]},
    {"code": "0x49", "any": ["skiing", "alpine skiing", "ski jumping", "figure skating", "curling"]},
    {"code": "0x4a", "any": ["equestrian", "horse racing", "rodeo"]},
    {"code": "0x4b", "any": ["martial arts", "mixed martial arts", "boxing", "judo", "pro wrestling"]},
    {"code": "0x41", "any": ["multi-sport event", "olympics", "summer olympics"]},
    {"code": "0x42", "any": ["sports talk"]},
    {"code": "0x40", "any": ["sports event", "sports non-event", "classic sport event", "playoff sports", "action sports", "cycling", "bicycle", "bicycle racing", "road cycling", "mountain biking", "golf", "darts", "snooker", "pool", "table tennis", "sport climbing", "cheerleading", "esports"]},

    {"code": "0x55", "all": ["children"], "any": ["animated", "anime"]},
    {"code": "0x54", "all": ["children"], "any": ["educational"]},
    {"code": "0x50", "any": ["children"]},

    {"code": "0x21", "any": ["weather"]},
    {"code": "0x22", "any": ["newsmagazine"]},
    {"code": "0x21", "any": ["news"]},
    {"code": "0x20", "any": ["public affairs"]},

    {"code": "0x91", "all": ["documentary"], "any": ["nature", "animals", "environment"]},
    {"code": "0x92", "all": ["documentary"], "any": ["science", "technology", "aviation"]},
    {"code": "0x93", "all": ["documentary"], "any": ["medical", "health"]},
    {"code": "0x83", "all": ["documentary"], "any": ["biography"]},
    {"code": "0x23", "any": ["documentary", "docudrama"]},

    {"code": "0xa5", "any": ["cooking"]},
    {"code": "0xa1", "any": ["travel"]},
    {"code": "0xa7", "any": ["house/garden", "home improvement"]},
    {"code": "0xa2", "any": ["arts/crafts", "how-to"]},
    {"code": "0xa3", "any": ["auto", "motorcycle"]},
    {"code": "0xa4", "any": ["exercise"]},
    {"code": "0x7b", "any": ["fashion"]},
    {"code": "0xa0", "any": ["fishing", "outdoors", "pets", "boat"]},

    {"code": "0x33", "any": ["talk"]},
    {"code": "0x31", "any": ["game show", "competition reality"]},
    {"code": "0x32", "any": ["variety"]},
    {"code": "0x30", "any": ["reality", "dokusoap"], "comment": "reality TV and German scripted-reality 'Dokusoap'"},

    {"code": "0x14", "any": ["sitcom"], "comment": "the format beats topic tags: Ghosts (Mystery), M*A*S*H (Historical drama), Futurama (Science fiction)"},
    {"code": "0x17", "all": ["religious"], "any": ["drama", "feature film", "movie", "tv movie"]},
    {"code": "0x17", "any": ["historical drama"]},
    {"code": "0x15", "any": ["soap"]},
    {"code": "0x11", "any": ["crime drama", "crime", "mystery", "thriller"]},
    {"code": "0x13", "any": ["science fiction", "fantasy", "horror", "paranormal"]},
    {"code": "0x12", "any": ["action", "adventure", "western", "war"]},
    {"code": "0x14", "any": ["comedy", "comedy drama", "romantic comedy", "dark comedy", "political satire", "standup", "komödie"]},
    {"code": "0x16", "any": ["romance"]},
    {"code": "0x10", "any": ["drama"], "comment": "medical and legal dramas also carry Drama; Medical or Law alone marks a factual programme"},

    {"code": "0x65", "any": ["musical", "musical comedy", "opera"]},
    {"code": "0x62", "any": ["classical"]},
    {"code": "0x61", "any": ["pop", "rock", "hip-hop & rap", "techno"]},
    {"code": "0x63", "any": ["folk"]},
    {"code": "0x60", "any": ["music", "concert", "dance"]},
    {"code": "0x71", "any": ["performing arts", "theater", "cabaret"]},
    {"code": "0x72", "any": ["art"]},
    {"code": "0x75", "any": ["books & literature"]},
    {"code": "0x73", "any": ["religious"]},

    {"code": "0x80", "any": ["politics", "community", "lgbtq", "military", "law"]},
    {"code": "0x82", "any": ["bus./financial", "consumer", "parenting", "self improvement"]},
    {"code": "0x24", "any": ["interview", "debate"]},
    {"code": "0x83", "any": ["biography"]},
    {"code": "0x91", "any": ["nature", "animals", "environment", "agriculture", "horse"]},
    {"code": "0x92", "any": ["science", "technology", "aviation"]},
    {"code": "0x93", "any": ["health", "medical"]},
    {"code": "0x95", "any": ["history", "ancient history", "world history", "american history"]},
    {"code": "0x90", "any": ["educational"]},

    {"code": "0x55", "any": ["animated", "anime"]},
    {"code": "0x10", "any": ["feature film", "movie", "tv movie", "miniseries", "short film", "filmreihe"]},
    {"code": "0x30", "any": ["entertainment"]}
  ],
  "ignore": ["series", "tvshow", "special", "event", "holiday", "family", "highlights", "tba", "off air", "static message", "podcast", "anthology"]
}
